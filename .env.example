# Tạo khóa bằng: openssl rand -hex 32
API_KEY=replace-with-at-least-32-random-characters

# Mặc định chỉ lắng nghe localhost. Dùng Nginx + HTTPS để truy cập từ xa.
BIND_ADDRESS=127.0.0.1
PORT=9000

# Chỉ các thư mục này xuất hiện trong File Manager.
# Thêm :ro để khóa ghi, ví dụ logs=/var/log:ro
MANAGED_ROOTS=opt=/opt;www=/var/www

# Tùy chọn cho repository GitHub riêng tư.
# Dùng fine-grained token chỉ có quyền Contents: Read cho đúng repository.
GIT_HTTP_USERNAME=x-access-token
GIT_HTTP_TOKEN=

MAX_READ_BYTES=2097152
MAX_WRITE_BYTES=4194304
MAX_UPLOAD_BYTES=104857600
METRICS_INTERVAL_SECONDS=5
METRICS_HISTORY_POINTS=720
